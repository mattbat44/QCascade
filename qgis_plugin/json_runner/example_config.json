{
  "paths": {
    "river_network_shp": "../inputs/input_trial/River_Network.shp",
    "discharge_csv": "../inputs/input_trial/Q_Vjosa.csv",
    "output_name": "Vjosa_test"
  },
  "sediment": {
    "range": [-8, 5],
    "n_classes": 6,
    "deposit_layer_thickness": 100000,
    "active_layer_depth": 0.3,
    "active_layer_method": 1
  },
  "time": {
    "timescale": 20,
    "ts_length": 86400
  },
  "physics": {
    "transport_capacity_formula": 2,
    "transport_partitioning": 4,
    "flow_depth_formula": 1,
    "velocity_formula": 2,
    "velocity_partitioning": 1,
    "slope_reduction": 1,
    "width_calculation": 1,
    "update_slope": false,
    "velocity_height": "2D90",
    "erosion_max": null
  },
  "options": {
    "save_deposit_layer": "never",
    "round_parameter": 0,
    "force_pass_external_inputs": false
  },
  "external_inputs": {
    "dir": "../inputs/external_inputs_example/",
    "grain_unit": "mm",
    "default_sigma_g": 1.6
  }
}
